{
  "name": "Product",
  "type": "object",
  "properties": {
    "serial_number": {
      "type": "integer",
      "description": "Unique serial number of this Little Miss variation (1-250 and growing)"
    },
    "name": {
      "type": "string",
      "description": "Variation name in Hebrew"
    },
    "name_en": {
      "type": "string",
      "description": "Optional English name"
    },
    "file_link": {
      "type": "string",
      "description": "Hyperlink to the actual product file"
    },
    "distribution_paused": {
      "type": "boolean",
      "default": false,
      "description": "Exclude from automatic package selection and warn on manual distribution"
    },
    "not_for_sale": {
      "type": "boolean",
      "default": false,
      "description": "Prevent adding this item to packages and new store deliveries"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "serial_number"
  ]
}